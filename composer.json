{
  "name": "youshido/graphql-bundle",
  "description": "Symfony GraphQl Bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Portey Vasil",
      "email": "portey@gmail.com"
    },
    {
      "name": "Alexandr Viniychuk",
      "email": "a@viniychuk.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Youshido\\GraphQLBundle\\": ""
    }
  },
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "youshido/graphql": "^2.0",
    "symfony/http-foundation": "^6.4 || ^7.0",
    "symfony/http-kernel": "^6.4 || ^7.0",
    "symfony/dependency-injection": "^6.4 || ^7.0",
    "symfony/config": "^6.4 || ^7.0",
    "symfony/console": "^6.4 || ^7.0",
    "symfony/routing": "^6.4 || ^7.0",
    "symfony/event-dispatcher": "^6.4 || ^7.0",
    "symfony/yaml": "^6.4 || ^7.0"
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/Yoopies/GraphQL.git"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "composer/composer": "^2.0",
    "symfony/framework-bundle": "^6.4 || ^7.0"
  }
}
